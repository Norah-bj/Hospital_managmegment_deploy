# Frontend environment example
# Set to true to use the Vite dev proxy (during local development)
VITE_USE_PROXY=false
# When VITE_USE_PROXY=true, point to your Java backend base URL
VITE_PROXY_TARGET=http://localhost:8080

# If not using proxy, the client will call this base URL directly
# e.g. https://api.example.com or http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080
